#!/bin/sh
# Native Codex launcher. It contains no workflow policy.
executable="${PLUGIN_ROOT:-}/bin/ff-integrity"
if [ ! -x "$executable" ]; then
  printf '%s\n' '{"systemMessage":"Feature Flow integrity observe-only: FFI_CAPABILITY_DEGRADED"}'
  exit 0
fi
exec "$executable" host-preflight --host codex --mode observe
