# Runtime run state (sandbox + manifests)
.feature-flow/

# Author-local dogfood: per-project config + promoted decision docs.
# Not shipped to plugin users — these are this repo dogfooding itself.
.feature-flow.json
docs/feature-flow/

# Author-local KB store (dogfood smoke). Plugin CODE ships; KB ENTRIES do not.
.feature-flow-kb/

# Dependencies
node_modules/

# Generated local Codex package
dist/

# Logs / OS cruft
*.log
.DS_Store
Thumbs.db

# Forward-test sandboxes are planted run state that MUST be committed (evals/forward/README.md)
!evals/forward/*/*/sandbox/.feature-flow/
!evals/forward/*/*/sandbox/.feature-flow.json
