#!/usr/bin/env bash
# Thin Claude lifecycle adapter. All applicability and transition decisions are
# made by the packaged native integrity kernel.
set -eu

hook_dir="$(cd "$(dirname "$0")" && pwd)"
case "$(uname -s 2>/dev/null || true)" in
  MINGW*|MSYS*|CYGWIN*) executable="$hook_dir/../bin/ff-integrity.exe" ;;
  *) executable="$hook_dir/../bin/ff-integrity" ;;
esac

if [[ ! -x "$executable" ]]; then
  printf '%s\n' '{"systemMessage":"Feature Flow integrity observe-only: FFI_CAPABILITY_DEGRADED"}'
  exit 0
fi

exec "$executable" host-preflight --host claude --mode observe
