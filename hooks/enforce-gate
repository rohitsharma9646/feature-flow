#!/usr/bin/env bash
# PreToolUse enforcement hook (M1): deny illegal manifest-state transitions.
# Fires on Write/Edit/MultiEdit; inert for everything except .feature-flow/*/manifest.json.
# Fail-OPEN on any indeterminate state (no jq, unparseable, missing fields,
# toggles.enforce=false). Deny ONLY on a determinate, illegal transition.
#
# Gates (see docs/schema/enforcement.md §Enforcement):
#   A. cannot enter `implement` without the track's sign-off precondition.
#   B. cannot reach `done` without valid on-disk verify (+ review on bugfix) evidence, and — on a
#      revision-bound run (v0.22.0) — unless review and verify both stamped the current revision.
#
# Output (Claude Code PreToolUse): exit 0 always; speak via stdout JSON.
set -u

INPUT="$(cat)"

# Cheap pre-filter: skip anything that isn't plausibly a ff manifest write.
# Avoids jq (and warn-spam) on the ~99% non-manifest Write case.
case "$INPUT" in
  *'.feature-flow/'*'manifest.json'*) : ;;
  *) exit 0 ;;
esac

# jq required past here. Absent -> fail-open + LOUD warning (printf, since jq is gone).
if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' '{"systemMessage":"feature-flow enforcement OFF: jq not found in PATH — manifest gates are NOT enforced. Install jq, or set toggles.enforce=false to silence."}'
  exit 0
fi

jqr() { printf '%s' "$INPUT" | jq -r "$1" 2>/dev/null; }

file_path="$(jqr '.tool_input.file_path // empty')"
case "$file_path" in
  */.feature-flow/*/manifest.json) : ;;
  *) exit 0 ;;
esac
cwd="$(jqr '.cwd // empty')"
run_dir="$(dirname "$file_path")"

# jqraw <filter>: exact raw string (jq -j adds no newline; the x sentinel keeps any
# trailing newlines that $(...) would otherwise strip).
jqraw() { local v; v="$(printf '%s' "$INPUT" | jq -j "$1" 2>/dev/null; printf x)"; printf '%s' "${v%x}"; }

# Proposed manifest = what the file will hold AFTER this tool call; invalid JSON -> fail-open.
# Write carries it whole. Edit/MultiEdit carry replacements: apply them, in order, to the
# on-disk manifest (literal match; first occurrence unless replace_all) and gate the result.
case "$(jqr '.tool_name // empty')" in
  Edit|MultiEdit)
    content=""                                           # missing file == empty file
    [ -f "$file_path" ] && { content="$(cat "$file_path"; printf x)"; content="${content%x}"; }
    edits='.tool_input | if (.edits | type) == "array" then .edits else [{old_string, new_string, replace_all}] end'
    n="$(jqr "$edits | length")"
    case "$n" in ''|*[!0-9]*) exit 0 ;; esac
    i=0
    while [ "$i" -lt "$n" ]; do
      old="$(jqraw "($edits)[$i].old_string // \"\"")"
      new="$(jqraw "($edits)[$i].new_string // \"\"")"
      if [ -z "$old" ]; then
        # Empty old_string on a missing/empty file is the tool's CREATE form: the file becomes
        # new_string, gated like a Write. On a non-empty file the tool rejects it -> fail-open.
        { [ "$i" -eq 0 ] && [ -z "$content" ]; } || exit 0
        content="$new"
      elif [ "${content#*"$old"}" = "$content" ]; then     # old_string not present (literal)
        exit 0                                           # no match (incl. missing file) -> the edit fails anyway
      elif [ "$(jqr "($edits)[$i].replace_all // false")" = "true" ]; then
        content="${content//"$old"/"$new"}"
      else
        content="${content/"$old"/"$new"}"
      fi
      i=$((i + 1))
    done ;;
  *) content="$(jqr '.tool_input.content // empty')" ;;
esac
printf '%s' "$content" | jq -e . >/dev/null 2>&1 || exit 0
mq() { printf '%s' "$content" | jq -r "$1" 2>/dev/null; }

# Kill switch: project override -> plugin default -> on. Read the RAW value (NOT
# `// empty`/`// false`: jq's `//` treats a literal `false` as empty, which would
# silently swallow the kill switch). Off ONLY when the resolved value is "false".
read_enforce() { jq -r '.toggles.enforce' "$1" 2>/dev/null; }   # "true" | "false" | "null" | ""
enforce=""
[ -n "$cwd" ] && [ -f "$cwd/.feature-flow.json" ] && enforce="$(read_enforce "$cwd/.feature-flow.json")"
case "$enforce" in
  true|false) : ;;   # project override is authoritative
  *)                 # unset/null/error -> consult the plugin default
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "$CLAUDE_PLUGIN_ROOT/config/defaults.json" ]; then
      enforce="$(read_enforce "$CLAUDE_PLUGIN_ROOT/config/defaults.json")"
    fi ;;
esac
[ "$enforce" = "false" ] && exit 0

track="$(mq '.track // empty')"
tier="$(mq '.tier // empty')"
phase="$(mq '.currentPhase // empty')"
{ [ -z "$track" ] || [ -z "$phase" ]; } && exit 0   # not a ff manifest / indeterminate

deny() { # $1 gate label  $2 reason
  jq -cn --arg m "feature-flow $1 — $2 (set toggles.enforce=false to override)" \
    '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$m}}'
  exit 0
}

# resolve_artifact_path <pointer>: manifest.artifacts.<name> value -> absolute path
# (shared by valid_artifact and valid_verify_evidence — one resolution rule, stated once).
resolve_artifact_path() {
  case "$1" in
    /*)  printf '%s' "$1" ;;
    */*) printf '%s' "${cwd:-$run_dir}/$1" ;;
    *)   printf '%s' "$run_dir/$1" ;;
  esac
}

# valid_artifact <pointer>: resolve via manifest.artifacts.<name> (never hardcoded),
# require present + non-empty + >=1 markdown heading.
valid_artifact() {
  local rel="$1" path
  [ -z "$rel" ] && return 1
  path="$(resolve_artifact_path "$rel")"
  [ -s "$path" ] && grep -qE '^#{1,6} ' "$path"
}

# valid_verify_evidence <pointer>: v0.9.0/AC10 content floor for artifacts.verify ONLY
# (see docs/schema/enforcement.md §Enforcement + docs/schema/evidence.md §Evidence). Requires a '## Contract mapping'
# heading and >=1 captured status token. Whole-file token grep on purpose: the floor
# command's exit code in '## Commands run' keeps an all-gaps + waived report passable —
# this denies an empty-shell report, it does NOT grade evidence quality or waiver coverage.
valid_verify_evidence() {
  local path
  path="$(resolve_artifact_path "$1")"
  grep -qE '^## Contract mapping' "$path" 2>/dev/null \
    && grep -qiE 'exit [0-9]+|HTTP[/ ]?[0-9]{3}|status[:= ] ?[0-9]+' "$path" 2>/dev/null
}

# Gate A — entering implement.
impl="$(mq '.phases.implement.status // empty')"
if [ "$phase" = "implement" ] || [ "$impl" = "in_progress" ] || [ "$impl" = "complete" ]; then
  case "$track/$tier" in
    feature/*|bugfix/full)
      [ "$(mq '.signOff.signed // false')" = "true" ] || \
        deny "Gate A" "cannot enter implement: spec not signed off (signOff.signed != true)" ;;
    bugfix/lite)
      [ "$(mq '.phases.diagnose.status // empty')" = "complete" ] || \
        deny "Gate A" "cannot enter implement: diagnosis not confirmed (phases.diagnose.status != complete)" ;;
  esac
fi

# Gate B — reaching done.
if [ "$phase" = "done" ]; then
  vrel="$(mq '.artifacts.verify // empty')"
  if [ "$(mq '.phases.verify.status // empty')" != "complete" ] || ! valid_artifact "$vrel" || ! valid_verify_evidence "$vrel"; then
    deny "Gate B" "cannot mark done: verify evidence missing or invalid (need phases.verify.status=complete + a non-empty verify artifact with a heading, a '## Contract mapping' section, and >=1 captured exit/HTTP/status code)"
  fi
  if [ "$track" = "bugfix" ]; then
    if [ "$(mq '.phases.review.status // empty')" != "complete" ] || ! valid_artifact "$(mq '.artifacts.review // empty')"; then
      deny "Gate B" "cannot mark done: review evidence missing or invalid (bugfix needs phases.review.status=complete + a non-empty review artifact with a heading)"
    fi
  fi

  # Revision binding (v0.22.0, docs/schema/enforcement.md §Enforcement): on a revision-bound run,
  # review and verify must each have stamped the CURRENT working-tree revision. Pre-0.22 runs
  # (no revisionBound) and projects outside git skip silently; a git repo where the revision
  # cannot be computed is allowed LOUDLY (AC9).
  if [ "$(mq '.revisionBound // false')" = "true" ]; then
    proj="${cwd:-$(dirname "$(dirname "$run_dir")")}"
    d="$proj"; in_git=""
    while [ -n "$d" ]; do
      [ -e "$d/.git" ] && { in_git=1; break; }
      next="$(dirname "$d")"
      [ "$next" = "$d" ] && break                 # reached / (or "." for a relative path)
      d="$next"
    done
    if [ -n "$in_git" ]; then
      cur=""
      lib="$(dirname "$0")/lib/revision.sh"
      [ -f "$lib" ] && . "$lib" && cur="$(revision_fingerprint "$proj")"
      if [ -z "$cur" ]; then
        rev_warn="feature-flow Gate B: revision binding NOT checked — the working-tree revision could not be computed (git missing or failing); done allowed without it"
      else
        for ph in review verify; do
          stamp="$(mq ".phases.$ph.revision // empty")"
          [ -n "$stamp" ] || deny "Gate B" "cannot mark done: $ph revision not recorded on a revision-bound run (re-run /feature-flow:ff-$ph so it stamps phases.$ph.revision)"
          [ "$stamp" = "$cur" ] || deny "Gate B" "cannot mark done: $ph revision is stale — the code changed after $ph ran (changed: $(revision_changed_paths "$proj" "$stamp" "$cur")); re-run /feature-flow:ff-$ph on the current tree"
        done
      fi
    fi
  fi
fi

[ -n "${rev_warn:-}" ] && jq -cn --arg m "$rev_warn" '{systemMessage:$m}'
exit 0
