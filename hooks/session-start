#!/usr/bin/env bash
# SessionStart hook for the feature-flow plugin.
# Emits a SHORT discovery pointer (NOT the skill content) so a fresh session
# knows the workflow exists and how to start it. The full workflow lives in the
# `feature-flow` skill and the /feature-flow:ff* commands, loaded on demand.

set -euo pipefail

# A SHORT pointer. Single-quoted so backticks/quotes stay literal. Deliberately
# does NOT include the skill's own content — that loads only when the skill runs.
pointer='feature-flow plugin is installed. For a non-trivial feature or a bug fix, prefer its durable, resumable, evidence-verified workflow instead of an ad-hoc edit: invoke the `feature-flow` skill, or run `/feature-flow:ff "<your request>"` to start a gated run. It auto-picks the feature track (explore->clarify->design->plan->implement->review->verify) or the test-first bugfix track (diagnose->regression-test->fix->verify->review), keeps all state in `.feature-flow/<slug>/`, and verifies with really-executed tests. Recover an interrupted run with `/feature-flow:ff-status` and `/feature-flow:ff-resume`.'

# Escape string for JSON embedding using bash parameter substitution (single
# C-level passes, no per-char loop).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Active-run re-anchor (v0.19.0). After a compaction or /clear the conversation no longer
# holds the run's state, but its manifest does. Emit a compact block per active run (not
# done / abandoned / closed; newest first, max 3) so the model resumes from disk instead of
# from a lossy summary. Best-effort: no jq, no cwd, no runs, or an unparseable manifest ->
# that part is simply omitted and the static pointer above is emitted unchanged.
INPUT=""
[ -t 0 ] || INPUT="$(cat 2>/dev/null || true)"

active_runs_block() {
  command -v jq >/dev/null 2>&1 || return 0
  local cwd source base dir f row rows=""
  cwd="$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)" || return 0
  { [ -n "$cwd" ] && [ -d "$cwd" ]; } || return 0
  source="$(printf '%s' "$INPUT" | jq -r '.source // empty' 2>/dev/null)"
  base=""
  [ -f "$cwd/.feature-flow.json" ] && base="$(jq -r '.paths.base // empty' "$cwd/.feature-flow.json" 2>/dev/null)"
  [ -n "$base" ] || base=".feature-flow"
  case "$base" in /*) dir="$base" ;; *) dir="$cwd/$base" ;; esac
  for f in "$dir"/*/manifest.json; do
    [ -f "$f" ] || continue
    row="$(jq -c --arg dir "$(basename "$(dirname "$f")")" --arg base "$base" '
      select(type == "object" and (.currentPhase | type) == "string"
             and .currentPhase != "done" and .currentPhase != "abandoned"
             and (.closedAt // null) == null)
      | (.slug // $dir) as $slug | (.tier // "full") as $tier
      | { updatedAt: (.updatedAt // ""),
          line: ("- \($slug) — \(.track // "?")/\($tier) · phase: \(.currentPhase) (\(.phases[.currentPhase].status // "unknown"))"
            + " · autopilot: \(if .autopilot == true then "on" else "off" end)"
            + " · signed off: \(if .track == "bugfix" and $tier == "lite" then "n/a" elif .signOff.signed == true then "yes" else "no" end)"
            + " · resume: /feature-flow:ff-resume \($slug)"
            + ([(.artifacts // {}) | to_entries[] | select((.value | type) == "string" and .value != "")
                | "\(.key)=\(if (.value | contains("/")) then .value else "\($base)/\($dir)/\(.value)" end)"]
               | if length > 0 then "\n  artifacts: " + join(", ") else "" end)) }' "$f" 2>/dev/null)" || continue
    [ -n "$row" ] && rows="$rows$row"$'\n'
  done
  [ -n "$rows" ] || return 0
  printf '%s' "$rows" | jq -rs --arg src "$source" '
    (if $src == "compact"
     then "Active feature-flow run(s) in this project (from on-disk manifests). You were mid-run before context compaction — continue the most recent run below from its current phase, and re-read its manifest and artifacts from these paths rather than relying on the compacted summary:"
     else "Active feature-flow run(s) in this project (from on-disk manifests). If the user'"'"'s request relates to one of them, re-enter it with its resume command and re-read its artifacts from disk; otherwise ignore this:"
     end) as $head
    | sort_by(.updatedAt) | reverse
    | [$head] + (.[:3] | map(.line))
      + (if length > 3 then ["(+\(length - 3) more — /feature-flow:ff-list)"] else [] end)
    | join("\n")' 2>/dev/null || true
}

runs="$(active_runs_block)"
[ -n "$runs" ] && pointer="$pointer"$'\n\n'"$runs"

# The run block copies manifest strings verbatim, and escape_for_json covers only \ " \n \r \t.
# With jq present, let it produce a fully escaped JSON string body (any U+0000–U+001F); without
# jq there is no run block, so the static pointer needs nothing beyond escape_for_json.
if command -v jq >/dev/null 2>&1; then
  session_context="$(jq -rn --arg c "$pointer" '$c | tojson | .[1:-1]')"
else
  session_context=$(escape_for_json "$pointer")
fi

# Emit only the field the current platform consumes (Claude Code reads both
# additional_context and hookSpecificOutput without dedup, so emit just one).
# Uses printf, not heredoc, to avoid the bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
