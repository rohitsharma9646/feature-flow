{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-flow.dev/schemas/attestation-v1.schema.json",
  "title": "Feature Flow assurance attestation v1",
  "type": "object",
  "required": ["attestationId", "kind", "status", "codeRevision", "producer", "recordedAt", "artifact", "evidenceRefs", "invalidation", "supersedes"],
  "properties": {
    "attestationId": {"type": "string", "pattern": "^ffa1:[0-9a-f]{64}$"},
    "kind": {"enum": ["review", "verification"]},
    "status": {"enum": ["passed", "failed", "unavailable"]},
    "codeRevision": {"type": "string", "pattern": "^ffr1:[0-9a-f]{64}$"},
    "producer": {
      "type": "object",
      "required": ["kind", "host", "id"],
      "properties": {
        "kind": {"enum": ["agent", "human", "ci"]},
        "host": {"enum": ["claude-code", "codex", "ci", "other"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "recordedAt": {"type": "string", "format": "date-time"},
    "artifact": {"type": "string", "minLength": 1},
    "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:[A-Za-z0-9._:-]+$"}},
    "invalidation": {"type": ["object", "null"]},
    "supersedes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
