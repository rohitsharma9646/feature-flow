{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-flow.dev/schemas/wp4-corpus-v1.schema.json",
  "title": "Feature Flow WP4 host-adapter corpus index",
  "type": "object",
  "required": ["schemaVersion", "cases", "executableParityVectors", "paths", "failureScenarios", "failureScenarioCoverage"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "kind", "test"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "test": {"type": "string", "pattern": "^Test[A-Za-z0-9]+$"}
        },
        "additionalProperties": false
      }
    },
    "executableParityVectors": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "allowed-feature",
          "denied-feature",
          "allowed-bugfix",
          "denied-bugfix",
          "legacy",
          "malformed-current",
          "terminal-incomplete",
          "duplicate",
          "payload-spoof",
          "unrelated"
        ]
      }
    },
    "paths": {
      "type": "array",
      "const": ["direct", "claude", "codex", "packaged-claude", "packaged-codex"]
    },
    "failureScenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"pattern": "^FS([1-9]|10)$"}
    },
    "failureScenarioCoverage": {
      "type": "object",
      "required": ["FS1", "FS2", "FS3", "FS4", "FS5", "FS6", "FS7", "FS8", "FS9", "FS10"],
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^Test[A-Za-z0-9]+$"}
      }
    }
  },
  "additionalProperties": false
}
