{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-flow.dev/schemas/preflight-request-v1.schema.json",
  "title": "Feature Flow host-neutral preflight request v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "host",
    "event",
    "operation",
    "toolClass",
    "target",
    "context",
    "requiredCapabilities",
    "enforcementMode"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "host": {"enum": ["direct", "claude", "codex"]},
    "event": {"enum": ["command_preflight", "pre_tool_use"]},
    "operation": {
      "enum": ["manifest_mutation", "code_mutation", "terminal_transition", "assurance_recording"]
    },
    "toolClass": {"enum": ["file_write", "shell", "command"]},
    "target": {"type": "string", "minLength": 1, "maxLength": 4096},
    "context": {
      "type": "object",
      "required": ["repositoryRoot", "runRoot"],
      "properties": {
        "repositoryRoot": {"type": "string", "minLength": 1, "maxLength": 4096},
        "runRoot": {"type": "string", "minLength": 1, "maxLength": 4096},
        "durableRoot": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "currentManifest": {"type": "object"},
    "proposedManifest": {"type": "object"},
    "expectedRevision": {"type": "string", "maxLength": 256},
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lifecycle_hook",
          "command_preflight",
          "kernel",
          "schema",
          "git_observation",
          "atomic_replacement",
          "json_output"
        ]
      }
    },
    "enforcementMode": {"enum": ["enforce", "observe"]}
  },
  "additionalProperties": false
}
